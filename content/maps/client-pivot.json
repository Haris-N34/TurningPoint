  "nodes": [
    {
      "id": "n-kickoff",
      "npc": "partner",
      "lines": [
        {
          "who": "partner",
          "text": "The client says 'modernise inventory'. That's not a brief. What do they actually need from us by Friday?",
          "expression": "neutral"
        }
      ],
      "prompt": "How do you frame the problem?",
      "options": [
        {
          "id": "a",
          "label": "Pin down one measurable goal with the client first",
          "effects": {
            "trust.firm": 8
          },
          "reaction": {
            "emote": "heart",
            "expression": "happy",
            "line": "Good. A goal we can be held to."
          }
        },
        {
          "id": "b",
          "label": "Start building a full system comparison right away",
          "effects": {
            "morale": -4
          },
          "reaction": {
            "emote": "sweat",
            "expression": "worried",
            "line": "That's a lot of work toward an unclear goal."
          }
        },
        {
          "id": "c",
          "label": "Ask the team what they think the brief is",
          "effects": {
            "morale": 4,
            "trust.firm": 2
          },
          "reaction": {
            "emote": "note",
            "expression": "neutral"
          }
        }
      ]
    },
    {
      "id": "n-data",
      "npc": "laptop",
      "lines": [
        {
          "who": "you",
          "text": "Three dashboards from the client. Mei pulled them last night.",
          "expression": "neutral"
        }
      ],
      "prompt": "What's the finding that matters?",
      "options": [
        {
          "id": "a",
          "label": "Stockouts are concentrated in the small stores, where orders are placed by hand",
          "effects": {
            "trust.firm": 6
          },
          "reaction": {
            "emote": "note",
            "expression": "happy"
          },
          "kpi": {
            "insight": "correct"
          }
        },
        {
          "id": "b",
          "label": "Stockouts are rising everywhere, so every store needs the new system",
          "effects": {},
          "reaction": {
            "emote": "question",
            "expression": "neutral"
          },
          "kpi": {
            "insight": "partial"
          }
        },
        {
          "id": "c",
          "label": "Food waste is the real problem, so lead with waste",
          "effects": {},
          "reaction": {
            "emote": "note",
            "expression": "neutral"
          },
          "unlocks": [
            "credibility-hit"
          ],
          "kpi": {
            "insight": "wrong"
          }
        }
      ],
      "charts": [
        {
          "title": "Stockouts per week",
          "unit": "",
