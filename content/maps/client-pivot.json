            [
              "Small stores",
              14
            ]
          ]
        }
      ]
    },
    {
      "id": "n-dev-estimate",
      "npc": "dev",
      "lines": [
        {
          "who": "dev",
          "text": "Honest answer? Integrating with their old till system is six weeks, not two.",
          "expression": "worried"
        }
      ],
      "prompt": "What do you do with Tomi's estimate?",
      "options": [
        {
          "id": "a",
          "label": "Put the real estimate in the plan and flag the risk",
          "effects": {
            "trust.firm": 4,
            "morale": 4
          },
          "reaction": {
            "emote": "heart",
            "expression": "happy",
            "line": "Thanks for not shaving it down."
          }
        },
        {
          "id": "b",
          "label": "Ask him to find a two-week version",
          "effects": {
            "morale": -8
          },
          "reaction": {
            "emote": "anger",
            "expression": "angry",
            "line": "That's how projects fail."
          }
        },
        {
          "id": "c",
          "label": "Leave integration out of the recommendation",
          "effects": {
            "trust.cfo": -4
          },
          "reaction": {
            "emote": "sweat",
            "expression": "worried"
          },
          "explainOnPick": true
        }
      ]
    },
    {
      "id": "n-manager-visit",
      "npc": "manager",
      "lines": [
        {
          "who": "manager",
          "text": "Last time head office 'modernised', my staff spent a month typing everything twice.",
          "expression": "angry"
        }
      ],
      "prompt": "What do you ask her?",
      "options": [
        {
          "id": "a",
          "label": "Ask her to walk you through how orders work today",
          "effects": {
            "trust.manager": 10
          },
          "reaction": {
            "emote": "heart",
            "expression": "happy",
            "line": "Nobody from head office has asked me that."
          }
        },
        {
          "id": "b",
          "label": "Reassure her the new system is much better",
          "effects": {
            "trust.manager": -4
          },
          "reaction": {
            "emote": "question",
            "expression": "neutral",
            "line": "They all say that."
          }
        },
        {
          "id": "c",
          "label": "Promise nothing changes for her team",
          "effects": {
            "trust.manager": 4,
            "trust.cfo": -4
          },
          "reaction": {
            "emote": "note",
            "expression": "neutral"
          },
          "explainOnPick": true
        }
      ]
    },
    {
      "id": "n-analyst-model",
      "npc": "analyst",
      "lines": [
        {
          "who": "analyst",
          "text": "I can forecast demand per store or per region. Per store is more accurate but takes two extra days.",
          "expression": "neutral"
        }
      ],
      "prompt": "Which forecast model?",
      "options": [
        {
          "id": "a",
          "label": "Per store for the small stores only",
          "effects": {
            "morale": 3
          },
          "reaction": {
            "emote": "note",
            "expression": "happy",
            "line": "Smart. That's where the problem is."
          }
        },
        {
          "id": "b",
          "label": "Per store everywhere",
          "effects": {
            "morale": -4
          },
          "reaction": {
            "emote": "sweat",
            "expression": "worried"
          },
          "minutes": 60
        },
        {
          "id": "c",
          "label": "Per region, it's good enough",
          "effects": {},
          "reaction": {
            "emote": "note",
            "expression": "neutral"
          }
        }
      ]
    },
    {
      "id": "n-pitch-manager",
      "npc": "manager",
      "lines": [
        {
          "who": "manager",
          "text": "So what are you actually recommending? In plain words, please.",
          "expression": "neutral"
        }
      ],
      "prompt": "How do you explain it to the store manager?",
      "options": [
        {
          "id": "a",
          "label": "'Your small stores stop running out of milk, and you stop typing orders by hand.'",
          "effects": {
            "trust.manager": 12
          },
          "reaction": {
            "emote": "heart",
            "expression": "happy",
            "line": "Now that I understand."
          },
          "kpi": {
            "fit": "good"
          }
        },
        {
          "id": "b",
          "label": "'We'll deploy a cloud ERP with ML-driven demand forecasting and API integration.'",
          "effects": {
            "trust.manager": -8
          },
          "reaction": {
            "emote": "question",
            "expression": "worried",
            "line": "...What?"
          },
          "kpi": {
            "fit": "poor"
          }
        },
        {
          "id": "c",
          "label": "'Kai told me the night shift reorders from memory. This fixes that first.'",
          "effects": {
            "trust.manager": 16
          },
          "reaction": {
            "emote": "heart",
            "expression": "happy",
            "line": "That's exactly it."
          },
          "explainOnPick": true,
          "requires": [
            "store-employee"
          ],
          "kpi": {
            "fit": "good"
          }
        }
      ]
    },
    {
      "id": "n-phased-plan",
      "npc": "laptop",
      "lines": [
        {
          "who": "you",
          "text": "The CFO cut the budget in half and wants a phased plan by Friday. The original plan doesn't fit any more.",
          "expression": "worried"
        }
      ],
      "prompt": "What goes in phase 1?",
      "options": [
        {
          "id": "a",
          "label": "Phase 1: the small stores only, where stockouts are worst",
          "effects": {
            "morale": 4
          },
          "reaction": {
            "emote": "note",
            "expression": "neutral"
          },
          "kpi": {
            "coreBudgetShare": 0.85
          }
        },
        {
          "id": "b",
          "label": "Phase 1: every store, but without the forecasting",
          "effects": {
            "morale": -2
          },
          "reaction": {
            "emote": "sweat",
            "expression": "worried"
          },
          "explainOnPick": true,
          "kpi": {
            "coreBudgetShare": 0.55
          }
        },
        {
          "id": "c",
          "label": "Push back and ask for the full budget",
          "effects": {
            "trust.cfo": -10
          },
          "reaction": {
            "emote": "anger",
            "expression": "worried"
          },
          "explainOnPick": true,
          "kpi": {
            "coreBudgetShare": 0.3
          }
        },
        {
          "id": "d",
          "label": "Phase 1: a cheap pilot in two stores, then decide",
          "effects": {
            "morale": 2
          },
          "reaction": {
            "emote": "note",
            "expression": "neutral"
          },
          "kpi": {
            "coreBudgetShare": 0.7
          }
        }
      ]
    },
    {
      "id": "n-team-worried",
      "npc": "dev",
      "lines": [
        {
          "who": "dev",
          "text": "Half the budget means half the work, right? Are we still doing this properly?",
          "expression": "worried"
        }
      ],
      "prompt": "What do you tell the team?",
      "options": [
        {
          "id": "a",
          "label": "Explain the phases and what each person owns now",
          "effects": {
            "morale": 12
          },
          "reaction": {
            "emote": "heart",
            "expression": "happy"
          }
        },
        {
          "id": "b",
          "label": "Tell them to keep going while you figure it out",
          "effects": {
            "morale": -6
          },
          "reaction": {
            "emote": "sweat",
            "expression": "worried"
          }
        },
        {
          "id": "c",
          "label": "Say the scope is the same, just faster",
          "effects": {
            "morale": -10
          },
          "reaction": {
            "emote": "anger",
            "expression": "angry"
          },
          "explainOnPick": true
        }
      ]
    },
    {
      "id": "n-cfo-call",
      "npc": "cfo",
      "lines": [
        {
          "who": "cfo",
          "text": "I need to know by tonight what you're cutting. Not the theory. What changes.",
          "expression": "angry"
        }
      ],
      "prompt": "What do you send the CFO?",
      "options": [
        {
          "id": "a",
          "label": "One page: what's in phase 1, what waits, and the cost of each",
          "effects": {
            "trust.cfo": 10
          },
          "reaction": {
            "emote": "note",
            "expression": "happy",
            "line": "Finally, something I can sign."
          }
        },
        {
          "id": "b",
          "label": "The full technical deck with a cover note",
          "effects": {
            "trust.cfo": -6
          },
          "reaction": {
            "emote": "question",
            "expression": "angry"
          }
        },
        {
          "id": "c",
          "label": "Ask for a week to rework everything",
          "effects": {
            "trust.cfo": -12
          },
          "reaction": {
            "emote": "anger",
            "expression": "angry"
          },
          "explainOnPick": true
        }
      ]
    },
    {
      "id": "n-pitch-cfo",
      "npc": "cfo",
      "lines": [
        {
          "who": "cfo",
          "text": "Convince me phase 1 is worth the money.",
          "expression": "neutral"
        }
      ],
      "prompt": "How do you make the case to the CFO?",
      "options": [
        {
          "id": "a",
          "label": "Lead with cost per store and payback: the small stores pay it back in 9 months",
          "effects": {
            "trust.cfo": 12
          },
          "reaction": {
            "emote": "heart",
            "expression": "happy",
            "line": "That's a number I can take to the board."
          },
          "kpi": {
            "fit": "good"
          }
        },
        {
          "id": "b",
          "label": "Walk him through the architecture diagram",
          "effects": {
            "trust.cfo": -8
          },
          "reaction": {
            "emote": "sweat",
            "expression": "worried",
            "line": "I'm not the IT department."
          },
          "kpi": {
            "fit": "poor"
          }
        },
        {
          "id": "c",
          "label": "Show why the 2019 rollout failed and how phase 1 avoids it",
          "effects": {
            "trust.cfo": 16
          },
          "reaction": {
            "emote": "heart",
            "expression": "happy",
            "line": "You did your homework."
          },
          "explainOnPick": true,
          "requires": [
            "cafe-chat"
          ],
          "kpi": {
            "fit": "good"
          }
        }
      ]
    },
    {
      "id": "n-feedback",
      "npc": "partner",
      "lines": [
        {
          "who": "partner",
          "text": "I read your deck. Honestly, it's unreadable. Twenty slides of features and no answer on slide one.",
          "expression": "angry"
        }
      ],
      "prompt": "How do you take it?",
      "options": [
        {
          "id": "a",
          "label": "Ask what he'd put on slide one, and rebuild it around that",
          "effects": {
            "trust.firm": 10
          },
          "reaction": {
            "emote": "heart",
            "expression": "happy",
            "line": "Answer first. Then evidence."
          },
          "kpi": {
            "feedback": "open"
          }
        },
        {
          "id": "b",
          "label": "Explain that the client asked for detail",
          "effects": {
            "trust.firm": -4
          },
          "reaction": {
            "emote": "note",
            "expression": "neutral",
            "line": "Then put the detail at the back."
          },
          "kpi": {
            "feedback": "defensive"
          }
        },
        {
          "id": "c",
          "label": "Say there's no time to change it now",
          "effects": {
            "trust.firm": -10
          },
          "reaction": {
            "emote": "anger",
            "expression": "angry"
          },
          "explainOnPick": true,
          "kpi": {
            "feedback": "dismissive"
          }
        }
      ]
    },
    {
      "id": "n-scope-creep",
      "npc": "manager",
      "lines": [
        {
          "who": "manager",
          "text": "Head office just asked: can the new system also handle online orders?",
          "expression": "worried"
        }
      ],
      "prompt": "How do you handle the new ask?",
      "options": [
        {
          "id": "a",
          "label": "Park it for phase 2, and write down why",
          "effects": {
            "trust.manager": 2,
            "trust.cfo": 4
          },
          "reaction": {
            "emote": "note",
            "expression": "neutral"
          }
        },
        {
          "id": "b",
          "label": "Say yes and squeeze it in",
          "effects": {
            "morale": -10,
            "trust.cfo": -4
          },
          "reaction": {
            "emote": "sweat",
            "expression": "worried"
          },
          "explainOnPick": true
        },
        {
          "id": "c",
          "label": "Say no, it's out of scope",
          "effects": {
            "trust.manager": -6
          },
          "reaction": {
            "emote": "anger",
            "expression": "angry"
          }
        }
      ]
    },
    {
      "id": "n-final-deck",
      "npc": "laptop",
      "lines": [
        {
          "who": "you",
          "text": "Friday morning. The deck needs to land in four hours.",
          "expression": "neutral"
        }
      ],
      "prompt": "What do you change last?",
      "options": [
